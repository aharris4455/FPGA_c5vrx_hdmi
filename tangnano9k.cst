// Tang Nano 9K - C5VRX digital CVBS tap to HDMI.
//
// Receiver inputs (3.3 V, bank 2, J6 header):
//   cvbs[0]  pin 25   <- C5VRX D4  / GPIO23  DAC bit 0 (LSB)
//   cvbs[1]  pin 26   <- C5VRX D5  / GPIO24  DAC bit 1
//   cvbs[2]  pin 27   <- C5VRX D3  / GPIO7   DAC bit 2 (D10 clock mode)
//   cvbs[3]  pin 28   <- C5VRX D7  / GPIO12  DAC bit 3
//   cvbs[4]  pin 29   <- C5VRX D8  / GPIO8   DAC bit 4
//   cvbs[5]  pin 30   <- C5VRX D9  / GPIO9   DAC bit 5 (MSB)
//   cvbs_clk pin 35   <- C5VRX D10 / GPIO10  40 MHz PARLIO sample clock
//   GND              <- C5VRX GND
//
// Tap before the resistor DAC.  Pin 35 is the LCD clock pin on the 40-pin
// FPC connector; leave that connector unconnected.

IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "resetn" 4;
IO_PORT "resetn" IO_TYPE=LVCMOS18 PULL_MODE=UP;

IO_LOC  "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led[1]" 11;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led[2]" 13;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led[3]" 14;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led[4]" 15;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led[5]" 16;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "cvbs[0]" 25;
IO_PORT "cvbs[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "cvbs[1]" 26;
IO_PORT "cvbs[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "cvbs[2]" 27;
IO_PORT "cvbs[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "cvbs[3]" 28;
IO_PORT "cvbs[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "cvbs[4]" 29;
IO_PORT "cvbs[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "cvbs[5]" 30;
IO_PORT "cvbs[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "cvbs_clk" 35;
IO_PORT "cvbs_clk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// HDMI connector: clock = 69/68, data0 = 71/70, data1 = 73/72, data2 = 75/74.
// The IO_TYPE goes on the _p port only; the _n pins must also be listed.
IO_LOC  "tmds_clk_p" 69;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC  "tmds_d_p[0]" 71;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC  "tmds_d_p[1]" 73;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC  "tmds_d_p[2]" 75;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;

IO_LOC  "tmds_clk_n" 68;
IO_LOC  "tmds_d_n[0]" 70;
IO_LOC  "tmds_d_n[1]" 72;
IO_LOC  "tmds_d_n[2]" 74;
