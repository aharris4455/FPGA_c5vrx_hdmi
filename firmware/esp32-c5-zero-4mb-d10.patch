diff --git a/main/experimental.c b/main/experimental.c
index 808a99b..7468e91 100644
--- a/main/experimental.c
+++ b/main/experimental.c
@@ -6,6 +6,10 @@
 #include <string.h>
 #include "esp_system.h"
 
+/* Local FPGA-tap build: force Clock Pin D10 on (web flasher has no
+ * experimental control for it). */
+#define C5VRX_FORCE_CLOCK_D10 1
+
 static experimental_blob_t s_exp = {.version = EXP_VERSION};
 static volatile bool s_save_pending;
 static uint32_t s_failed, s_revision;
@@ -48,6 +52,9 @@ void experimental_load(void)
     if (experimental_blob_valid(&b)) s_exp = b;
 #ifdef HWX_NO_DAC
     s_exp.value[EXP_CLOCK_D10] = 0;   /* D10 is a hardware experiment pad */
+#endif
+#ifdef C5VRX_FORCE_CLOCK_D10
+    s_exp.value[EXP_CLOCK_D10] = 1;   /* FPGA tap build: D10 always requested */
 #endif
     s_clock_d10 = experimental_get(EXP_CLOCK_D10) != 0;
 }
